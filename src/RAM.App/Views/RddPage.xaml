<Page
    x:Class="RAM.Views.RddPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RAM.Views">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,16" Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="RDD — Roblox Deployment Downloader" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock
                Text="Download a full Roblox deployment straight from Roblox's CDN. Pick 'Default' for the latest live build, or an exploit to get the exact version it supports. Installs are tagged and stored in the folder below — this app only ever uses these RDD installs, never the normal Roblox installation. The deployment marked 'Active' is the one Accounts Launch and the Fast Flags page target — click 'Set active' on any install to switch."
                TextWrapping="Wrap" Opacity="0.7"/>

            <!-- Downloader -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Download a deployment" FontWeight="SemiBold" FontSize="16"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Install folder" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RootBox" Grid.Column="0"
                                     PlaceholderText="Folder where deployments are stored"
                                     LostFocus="RootBox_LostFocus" KeyDown="RootBox_KeyDown"/>
                            <Button Grid.Column="1" Content="Browse…" Click="BrowseRoot_Click">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="O"/>
                                </Button.KeyboardAccelerators>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="RootHintText" FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Exploit / version" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ExploitBox" Grid.Column="0"
                                      SelectionChanged="ExploitBox_SelectionChanged" KeyDown="ExploitBox_KeyDown"/>
                            <Button Grid.Column="1" Content="Refresh" Click="RefreshExploits_Click">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="R"/>
                                </Button.KeyboardAccelerators>
                            </Button>
                        </Grid>
                        <Border x:Name="ExploitInfoPanel" CornerRadius="8" Background="#14FFFFFF"
                                Padding="12,10" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="ExploitInfoTitle" FontWeight="SemiBold"/>
                                    <Border x:Name="ExploitStatusChip" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="ExploitStatusText" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="ExploitInfoDetail" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <HyperlinkButton x:Name="ExploitWebsiteLink" FontSize="12" Visibility="Collapsed"/>
                                    <HyperlinkButton x:Name="ExploitDiscordLink" FontSize="12" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="DownloadButton" Click="DownloadButton_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="14"/>
                                <TextBlock Text="Download &amp; install"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" Visibility="Collapsed"/>
                    </StackPanel>

                    <ToggleSwitch x:Name="ParallelDownloadsToggle" Header="Parallel downloads (faster on good connections)"
                                 OffContent="Off" OnContent="On" Toggled="ParallelDownloadsToggle_Toggled"/>

                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="Progress" Grid.Column="0" IsIndeterminate="True" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProgressPercentText" Grid.Column="1" FontSize="12" Opacity="0.7"
                                       MinWidth="44" TextAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="ProgressDetailText" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Installed deployments -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Installed deployments" FontWeight="SemiBold" FontSize="16"/>
                        <Border x:Name="InstallsCountBadge" CornerRadius="10" Background="#2A3B55" Padding="8,2"
                                VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="InstallsCountText" FontSize="11" Foreground="#9FC6FF"/>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="EmptyState" Padding="20,28" Spacing="8" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE7FC;" FontSize="36" Opacity="0.35" HorizontalAlignment="Center"/>
                        <TextBlock Text="No deployments installed yet" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Opacity="0.7"/>
                        <TextBlock Text="Pick Default (latest Roblox) or an exploit above, then hit Download &amp; install."
                                   HorizontalAlignment="Center" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="DefaultUpdateStatus" FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <ListView x:Name="InstallsList" SelectionMode="None" MaxHeight="340" Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:RddInstallInfo">
                                <Border CornerRadius="10" Background="#14FFFFFF" Padding="14,12" Margin="0,0,0,10">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="42" Height="42" CornerRadius="10" Background="#1F2E4D"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="#6CA9FF"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{x:Bind Version}" FontWeight="SemiBold" FontSize="14"/>
                                                <Border Background="{x:Bind TagChipBackground}" CornerRadius="8"
                                                        Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Tag}" FontSize="11"
                                                               Foreground="{x:Bind TagChipForeground}"/>
                                                </Border>
                                                <Border Background="{x:Bind ActiveChipBackground}" CornerRadius="8"
                                                        Padding="8,2" VerticalAlignment="Center"
                                                        Visibility="{x:Bind ActiveChipVisibility}">
                                                    <TextBlock Text="Active" FontSize="11"
                                                               Foreground="{x:Bind ActiveChipForeground}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind FolderPath}" FontSize="11" Opacity="0.55"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind InstalledText}" FontSize="11" Opacity="0.45"/>
                                                <TextBlock Text="·" FontSize="11" Opacity="0.45"/>
                                                <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" FontSize="11" Opacity="0.45"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Button Content="Set active" Click="SetActive_Click" FontSize="12" Padding="10,4"
                                                    Visibility="{x:Bind SetActiveVisibility}"
                                                    ToolTipService.ToolTip="Make this the deployment Accounts Launch and the Fast Flags page target"/>
                                            <SplitButton Click="Play_Click" FontSize="12" Tag="{x:Bind}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE768;" FontSize="12"/>
                                                    <TextBlock Text="Play"/>
                                                </StackPanel>
                                                <SplitButton.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Play with Place ID" Click="PlayWithPlaceId_Click" Tag="{x:Bind}"/>
                                                    </MenuFlyout>
                                                </SplitButton.Flyout>
                                            </SplitButton>
                                            <Button Content="Re-download" Click="Redownload_Click" FontSize="12" Padding="10,4"/>
                                            <Button Content="Delete" Click="Delete_Click" FontSize="12" Padding="10,4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
