<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>RAM.Installer</RootNamespace>
    <AssemblyName>RAM.Installer</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Same icon as the app (single canonical copy under RAM.App/Assets). -->
    <ApplicationIcon>..\RAM.App\Assets\ram.ico</ApplicationIcon>
    <!-- We provide our own Main so the same binary can also run in pack (console) mode. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>RAM.Installer.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <!-- Generated by scripts/build-installer.sh: the Brotli-compressed app payload. -->
    <EmbeddedResource Include="$(PayloadPath)" Condition="Exists('$(PayloadPath)')" Link="payload.br" />
  </ItemGroup>
</Project>
