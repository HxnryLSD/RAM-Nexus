<ContentDialog
    x:Class="RAM.Dialogs.UnlockDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Accounts are password locked"
    PrimaryButtonText="Unlock"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="360">
        <TextBlock Text="Enter your password to decrypt the account file. It stays locked until you unlock it with the correct password."
                   TextWrapping="Wrap" Opacity="0.8"/>
        <PasswordBox x:Name="PasswordBox" Header="Password"/>
        <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   Visibility="Collapsed" TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>
