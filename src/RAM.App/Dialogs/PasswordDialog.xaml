<ContentDialog
    x:Class="RAM.Dialogs.PasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="360">
        <PasswordBox x:Name="CurrentBox" Header="Current password"/>
        <PasswordBox x:Name="NewBox" Header="New password"/>
        <PasswordBox x:Name="ConfirmBox" Header="Confirm password"/>
        <TextBlock x:Name="HintText" Text="Use at least 4 characters." Opacity="0.6" FontSize="12"/>
        <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   Visibility="Collapsed" TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>
