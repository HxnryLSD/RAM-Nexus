<ContentDialog
    x:Class="RAM.Dialogs.EditAccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit account"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="400">
        <TextBlock x:Name="HeaderText" FontWeight="SemiBold" Opacity="0.8" TextWrapping="Wrap"/>

        <TextBox x:Name="AliasBox" Header="Alias" MaxLength="50"
                 PlaceholderText="Optional display name shown instead of the username"/>
        <TextBox x:Name="GroupBox" Header="Group" MaxLength="200"
                 PlaceholderText="e.g. Main, Bank, Testing"/>
        <TextBox x:Name="NotesBox" Header="Notes" MaxLength="5000" AcceptsReturn="True" Height="90"
                 TextWrapping="Wrap" PlaceholderText="Anything you want to remember about this account"/>

        <StackPanel Spacing="6">
            <TextBlock Text="Stored password" FontWeight="SemiBold" FontSize="13"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PasswordBox x:Name="PasswordBox" Width="260" PlaceholderText="Optional"/>
                <Button Content="Generate" Click="Generate_Click" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Stored inside your encrypted vault only — never sent to Roblox."
                       FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Copy cookie" Click="CopyCookie_Click"/>
            <TextBlock x:Name="CopyCookieStatus" VerticalAlignment="Center" FontSize="12" Opacity="0.6"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>
