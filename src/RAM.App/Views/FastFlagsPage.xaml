<Page
    x:Class="RAM.Views.FastFlagsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="RootPanel" Padding="24,16" Spacing="6" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Fast Flags" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock
                Text="Turn on an allowed fast flag to override Roblox's default behaviour, then set its value. Values are only applied when their flag is activated. This is limited to Roblox's allow list so it won't trip game-manipulation detection."
                TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>

            <TextBlock Text="Target install" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <ComboBox x:Name="TargetBox" MinWidth="360" SelectionChanged="TargetBox_SelectionChanged"/>
            <TextBlock
                Text="Fast flags and the FPS unlock are applied to the active RDD install — the one Accounts Launch uses (change it on the RDD page, or pick a different install here). The normal Roblox installation is never modified."
                TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                <Button x:Name="ApplyButton" Content="Apply to active install" Click="ApplyButton_Click"/>
                <TextBlock x:Name="ApplyStatus" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.8"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
